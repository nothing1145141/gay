{
  "name": "photolab-desktop",
  "productName": "PhotoLab",
  "version": "1.0.0",
  "description": "PhotoLab — 本地照片调色器（Electron 壳）",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "nothing1145141",
  "license": "SEE LICENSE IN ../LICENSE",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.photolab.app",
    "productName": "PhotoLab",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "afterpack.cjs", "package.json"],
    "afterPack": "afterpack.cjs",
    "extraResources": [
      { "from": "../backend-dist/photolab-server", "to": "backend" }
    ],
    "win": {
      "icon": "../build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PhotoLab-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PhotoLab-Portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "nothing1145141",
      "repo": "gay"
    }
  }
}
